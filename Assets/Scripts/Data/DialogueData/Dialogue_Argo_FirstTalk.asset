  dialogueId: argo_first_talk
  lines:
  - speakerId: Argo_002
    speakerName: Argo
    portrait: {fileID: 21300000, guid: 96d63b07219cf034ebaf0294e2ef3a4d, type: 3}
    text: Hey, Paul. You finally made it.
  - speakerId: Paul_001
    speakerName: Paul
    portrait: {fileID: 21300000, guid: 8bffb6c5b9fc959469ec958c555af0e1, type: 3}
    text: Argo? What are you doing here?
  - speakerId: Argo_002
    speakerName: Argo
    portrait: {fileID: 21300000, guid: 96d63b07219cf034ebaf0294e2ef3a4d, type: 3}
    text: Waiting. Mostly. Also trying not to get eaten.
