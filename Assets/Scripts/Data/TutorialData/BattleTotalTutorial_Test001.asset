  m_Script: {fileID: 11500000, guid: e208ff7074ed7c74f8447d8e400193c6, type: 3}
  m_Name: BattleTotalTutorial_Test001
  m_EditorClassIdentifier: 
  tutorialId: BattleTotalTutorial_Test001
  steps:
  - title: Turn Order
    message: Watch the timeline to see which character will act next.
  - title: Commands
    message: When it is your turn, choose Attack, Skill, Item, or Run.
  - title: Enemy Target
    message: After choosing an action, select an enemy target. You can click an enemy,
      press Tab to cycle targets, or use A / D to move between enemies.
  - title: Ally Target
    message: Some skills and items target party members. For now, press Tab to switch
      between available ally targets.
  - title: HP / MP
    message: HP reaching 0 means the character is defeated. Skills consume MP, and
      items can recover HP, MP, or revive defeated allies.
  - title: Victory Rewards
    message: Win the battle to gain EXP and item rewards. Run lets you escape and
      return to the field.
